# Copy this file to .streamlit/secrets.toml (local dev) and fill in the real values from the
# service account JSON key you downloaded in Google Cloud Console — see SETUP.md.
#
# .streamlit/secrets.toml is gitignored, so it is never committed. For the deployed app, paste
# the same content into Streamlit Community Cloud's app settings -> Secrets box instead of
# creating this file on the server.

SHEET_ID = "paste-the-id-from-your-google-sheet-url-here"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
paste-the-full-multiline-private-key-here-including-the-BEGIN-and-END-lines
-----END PRIVATE KEY-----
"""
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "your-cert-url"
universe_domain = "googleapis.com"
